#!/bin/bash
#SBATCH --partition=P2
#SBATCH --cpus-per-task=1
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --exclude=b03,b14,b15,b24,b25,b26,b27,b28,b30,b31
# Analysis and independent arithmetic for one block of the selected-rho addendum, with its frozen code.
# Usage: CODE_ID=<freeze> RUN_DIR=<run> sbatch --export=ALL --chdir=<run> --output=<run>/logs/%x-%j.out \
#   -J icmsel-analyze-<block> jobs/analyze.sbatch core|stress <tag>
# Runs are the active shard directories only: moved-aside attempts (*.<suffix>) are kept and never passed.
set -uo pipefail
BLOCK=${1:?core|stress}; TAG=${2:?tag}
case "$BLOCK" in
  core)   P=out-core;   N=1984; W=results/v1_wave2 ;;
  stress) P=out-stress; N=1024; W=results/stress_wave2 ;;
  *) echo "unknown block $BLOCK"; exit 2 ;;
esac
GROUP=gp source jobs/common.sh
mapfile -t RUNS < <(find "$P" -mindepth 1 -maxdepth 1 -type d ! -name '*.*' | sort)
echo "$P: ${#RUNS[@]} active shard directories"
[ "${#RUNS[@]}" -eq "$N" ] || { echo "expected $N"; exit 3; }
CFG=$CODE/configs/v1_icm_selected_$BLOCK.toml
LIMIT=(); [ -f "joblimit-$BLOCK.json" ] && LIMIT=(--job-limit-shards "joblimit-$BLOCK.json")
OUT=analysis-$BLOCK-$TAG
sha256sum "$CODE/scripts/analyze_icm_selected.py" "$CODE/scripts/verify_icm_selected.py" "$CFG"
"$PY" "$CODE/scripts/analyze_icm_selected.py" --config "$CFG" --runs "${RUNS[@]}" --wave2 "$CODE/$W" \
  --output "$OUT" "${LIMIT[@]}" > "logs/$OUT.stdout" 2>&1
rc=$?; echo "analyzer exit $rc"; tail -3 "logs/$OUT.stdout"
[ $rc -eq 0 ] || exit $rc
"$PY" "$CODE/scripts/verify_icm_selected.py" arithmetic --block "$BLOCK" --analysis "$OUT" --runs "${RUNS[@]}" \
  --wave2 "$CODE/$W" --output "checks-$BLOCK-$TAG-arithmetic.json" "${LIMIT[@]}" \
  > "logs/checks-$BLOCK-$TAG-arithmetic.stdout" 2>&1
rc=$?; echo "arithmetic exit $rc"
exit $rc
